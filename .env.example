# Copy this file to .env and fill in your own values.
# Every key here can also be set in config.toml under its matching
# [section] - .env/environment variables win if both are set.

# --- Business profile ---
GUSS_BUSINESS__NAME=My Shop
GUSS_BUSINESS__CURRENCY=USD
# "en" or "id" (Bahasa Indonesia)
GUSS_BUSINESS__LANGUAGE=en
GUSS_BUSINESS__TIMEZONE=UTC

# --- LLM (one OpenAI-compatible provider works for all of these) ---
# Ollama (local, free, no key): http://localhost:11434/v1
# Groq (free tier, fast):       https://api.groq.com/openai/v1
# OpenAI:                        https://api.openai.com/v1
GUSS_LLM__BASE_URL=http://localhost:11434/v1
GUSS_LLM__API_KEY=
GUSS_LLM__MODEL=llama3.1

# --- Storage ---
# SQLite (default, zero config): sqlite://guss.db
# Postgres/Supabase:              postgres://user:pass@host:5432/dbname
GUSS_STORE__URL=sqlite://guss.db

# --- Speech-to-text (local Whisper, no key needed) ---
# Download a model per docs/setup-elevenlabs-piper.md and point here.
GUSS_STT__WHISPER_MODEL_PATH=models/ggml-base.en.bin

# --- Text-to-speech ---
# "piper" (free, local, default) or "elevenlabs"
GUSS_TTS__PROVIDER=piper
GUSS_TTS__ELEVENLABS_API_KEY=
GUSS_TTS__ELEVENLABS_VOICE_ID=

# --- Channel ---
# "cli", "telegram", or "whatsapp"
GUSS_CHANNEL__KIND=cli
GUSS_CHANNEL__TELEGRAM_BOT_TOKEN=
GUSS_CHANNEL__WHATSAPP_VERIFY_TOKEN=
GUSS_CHANNEL__WHATSAPP_ACCESS_TOKEN=
GUSS_CHANNEL__WHATSAPP_PHONE_NUMBER_ID=
